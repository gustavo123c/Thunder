# Copy to .env.local (git-ignored) and fill in.
# EXPO_PUBLIC_* values are embedded in the app bundle: public keys only, never secrets.

# Supabase local (`npm run db:start` prints these) or your hosted project's API settings.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (starts with pk.) — https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
