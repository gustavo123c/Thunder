{
  "expo": {
    "name": "Thunder",
    "slug": "thunder",
    "scheme": "thunder",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.thunder.run",
      "supportsTablet": false
    },
    "android": {
      "package": "app.thunder.run",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Thunder usa sua localização para registrar o trajeto, a distância e o pace das suas corridas.",
          "locationAlwaysAndWhenInUsePermission": "O Thunder continua registrando sua corrida com a tela bloqueada ou o app em segundo plano.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Thunder acessa suas fotos para você adicionar imagens e vídeos às corridas e trocar sua foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
